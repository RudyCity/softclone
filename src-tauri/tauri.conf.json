{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoftClone",
  "version": "0.6.1",
  "identifier": "com.rudycity.softclone",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SoftClone",
        "width": 1260,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE"
    },
    "shortDescription": "Local application clones and independent profiles"
  }
}
